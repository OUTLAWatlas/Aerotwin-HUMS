# Copy to .env and fill in real values before deploying.

PM_ENVIRONMENT=dev
PM_LOG_LEVEL=INFO

PM_DATABASE_URL=postgresql+asyncpg://pm_user:pm_pass@localhost:5432/pm_db
PM_DB_POOL_SIZE=20
PM_DB_MAX_OVERFLOW=10

PM_JWT_SECRET_KEY=change-me-to-a-long-random-value
PM_JWT_ALGORITHM=HS256
PM_JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
PM_JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

PM_TLS_CERT_PATH=/etc/pm/certs/server.crt
PM_TLS_KEY_PATH=/etc/pm/certs/server.key
PM_TLS_MIN_VERSION=TLSv1.3

# JSON array -- origins the AeroTwin-HUMS dashboard dev server runs on.
PM_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

PM_MQTT_BROKER_HOST=localhost
PM_MQTT_BROKER_PORT=8883
PM_MQTT_TOPIC_PREFIX=pm/sensors/#
PM_CAN_INTERFACE=can0
PM_CAN_BUSTYPE=socketcan
PM_INGESTION_QUEUE_MAXSIZE=10000

PM_INFERENCE_TIMEOUT_SECONDS=0.1
PM_ALERT_DEDUP_WINDOW_SECONDS=900

PM_REDIS_URL=redis://localhost:6379/0
