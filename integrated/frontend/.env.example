# Copy to .env to override defaults. Not required for normal local dev --
# see INTEGRATION.md at the repo root.

# Force the dashboard back into its built-in simulator/demo mode even while
# signed in (useful for showing the UI without a backend running at all).
# VITE_DISABLE_LIVE_BACKEND=true

# Override the REST/WebSocket base URLs instead of relying on Vite's dev
# proxy (see vite.config.js) -- useful when the frontend is built/served
# separately from the backend (e.g. a static build behind its own nginx).
# VITE_API_BASE=https://api.example.com/api/v1
# VITE_WS_BASE=wss://api.example.com/ws/telemetry
